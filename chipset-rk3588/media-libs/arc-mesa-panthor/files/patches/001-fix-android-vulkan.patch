+static bool
+panvk_image_update_layouts(struct panvk_image *image,
+                           const VkImageDrmFormatModifierExplicitCreateInfoEXT *explicit_info)
+{
+	 struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(image->vk.base.device->physical);
+   unsigned arch = pan_arch(phys_dev->kmod.props.gpu_prod_id);
+	 image->plane_count = explicit_info->drmFormatModifierPlaneCount;
+	 if (image->vk.format == VK_FORMAT_D32_SFLOAT_S8_UINT)
+      image->plane_count = 2;
+
+   mesa_logd("%s: ENTER - fmt=%d, modifier=0x%lx, plane_count=%u, arch=%u",
+             __func__, image->vk.format, (unsigned long)explicit_info->drmFormatModifier,
+             image->plane_count, arch);
+
+   for (uint8_t plane = 0; plane < image->plane_count; plane++) {
+      VkFormat format =
+         (image->vk.format == VK_FORMAT_D32_SFLOAT_S8_UINT) ?
+         ((plane == 0) ? VK_FORMAT_D32_SFLOAT : VK_FORMAT_S8_UINT) :
+         image->vk.format;
+
+      struct pan_image_explicit_layout plane_layout;
+      if (explicit_info)
+         plane_layout = (struct pan_image_explicit_layout){
+            .offset = explicit_info->pPlaneLayouts[plane].offset,
+            .row_stride = explicit_info->pPlaneLayouts[plane].rowPitch,
+         };
+
+      mesa_logd("%s: plane[%u] - offset=%lu, rowPitch=%lu, fmt=%d",
+                __func__, plane, (unsigned long)plane_layout.offset,
+                (unsigned long)plane_layout.row_stride, format);
+
+      image->planes[plane].layout = (struct pan_image_layout){
+         .format = vk_format_to_pipe_format(format),
+         .dim = panvk_image_type_to_mali_tex_dim(image->vk.image_type),
+         .width = image->vk.extent.width,
+         .height = image->vk.extent.height,
+         .depth = image->vk.extent.depth,
+         .array_size = image->vk.array_layers,
+         .nr_samples = image->vk.samples,
+         .nr_slices = image->vk.mip_levels,
+      };
+
+      image->planes[plane].layout.modifier = image->vk.drm_format_mod;
+      if (!pan_image_layout_init(arch, &image->planes[plane].layout,
+                            &plane_layout)) {
+         mesa_loge("%s: pan_image_layout_init FAILED for plane %u", __func__, plane);
+				return false;
+      }
+      mesa_logd("%s: plane[%u] layout init SUCCESS - data_size=%lu, row_stride=%u, slice_stride=%u",
+                __func__, plane, (unsigned long)image->planes[plane].layout.data_size,
+                image->planes[plane].layout.slices[0].row_stride,
+                image->planes[plane].layout.slices[0].surface_stride);
+   }
+   uint64_t total_size = 0;
+   for (uint8_t plane = 0; plane < image->plane_count; plane++) {
+      total_size += image->planes[plane].layout.data_size;
+   }
+   mesa_logd("%s: all planes initialized successfully - total_size=%lu", __func__, (unsigned long)total_size);
+	 return true;
+}
