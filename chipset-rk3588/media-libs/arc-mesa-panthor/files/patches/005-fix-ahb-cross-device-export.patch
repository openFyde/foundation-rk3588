Index: mesa3d/src/panfrost/vulkan/panvk_device_memory.h
===================================================================
--- mesa3d.orig/src/panfrost/vulkan/panvk_device_memory.h
+++ mesa3d/src/panfrost/vulkan/panvk_device_memory.h
@@ -28,6 +28,11 @@ struct panvk_device_memory {
 
    bool is_for_wsi;
    uint32_t dumb_handle;  /* DRM dumb buffer handle for WSI allocations */
+
+   /* For imported AHB buffers, keep the original dmabuf fd to avoid
+    * cross-device import issues when re-exporting. The fd is dup'd to
+    * keep it valid after the original handle is closed. */
+   int imported_ahb_fd;
 };
 
 VK_DEFINE_NONDISP_HANDLE_CASTS(panvk_device_memory, vk.base, VkDeviceMemory,
