@@ -322,6 +319,12 @@ panvk_FreeMemory(VkDevice _device, VkDev
 
    panvk_memory_munmap(mem);
 
+   /* Close saved AHB fd if this was an AHB import */
+   if (mem->imported_ahb_fd >= 0) {
