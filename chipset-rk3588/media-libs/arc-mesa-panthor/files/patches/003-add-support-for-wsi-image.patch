+      struct panvk_physical_device *pdevice =
+         to_panvk_physical_device(device->vk.physical);
+      device_free_wsi_dumb(pdevice->drm.display_render_fd, mem->dumb_handle);
+   }
+
    struct pan_kmod_vm_op op = {
       .type = PAN_KMOD_VM_OP_TYPE_UNMAP,
       .va = {
