+static void
+device_free_wsi_dumb(int display_render_fd, uint32_t dumb_handle)
+{
+   assert(display_render_fd >= 0);
+   if (dumb_handle == 0)
+      return;
+
+   struct drm_mode_destroy_dumb destroy_dumb = {
+      .handle = dumb_handle,
+   };
+
+   if (drmIoctl(display_render_fd, DRM_IOCTL_MODE_DESTROY_DUMB, &destroy_dumb)) {
+      mesa_loge("destroy dumb object %d: %s\n", dumb_handle, strerror(errno));
+   }
+}
+
+static VkResult
+device_alloc_for_wsi(struct panvk_device *device,
+                     const VkAllocationCallbacks *pAllocator,
+                     struct panvk_device_memory *mem,
+                     VkDeviceSize size)
+{
+   VkResult result;
+   struct panvk_physical_device *pdevice =
+      to_panvk_physical_device(device->vk.physical);
+   assert(pdevice->drm.display_render_fd >= 0);
+
+   mem->is_for_wsi = true;
+
+   int display_fd = pdevice->drm.display_render_fd;
+   struct drm_mode_create_dumb create_dumb = {
+      .width = 1024, /* one page */
+      .height = align(size, 4096) / 4096,
+      .bpp = util_format_get_blocksizebits(PIPE_FORMAT_RGBA8888_UNORM),
+   };
+
+   int err;
+   err = drmIoctl(display_fd, DRM_IOCTL_MODE_CREATE_DUMB, &create_dumb);
+   if (err < 0)
+      goto fail_create;
+
+   int fd;
+   err = drmPrimeHandleToFD(display_fd, create_dumb.handle, O_CLOEXEC, &fd);
+   if (err < 0)
+      goto fail_export;
+
+   /* Import the dma-buf into panfrost */
+   mem->bo = pan_kmod_bo_import(device->kmod.dev, fd, 0);
+   close(fd);
+   if (!mem->bo) {
+      result = panvk_error(device, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      goto fail_import;
+   }
+
+   mem->dumb_handle = create_dumb.handle;
+   return VK_SUCCESS;
+
+fail_import:
+fail_export:
+   device_free_wsi_dumb(display_fd, create_dumb.handle);
+
+fail_create:
+   return panvk_error(device, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+}
+
 static void
