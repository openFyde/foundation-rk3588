+      vk_find_struct_const(pAllocateInfo->pNext, WSI_MEMORY_ALLOCATE_INFO_MESA);
    const VkImportMemoryFdInfoKHR *fd_info =
       vk_find_struct_const(pAllocateInfo->pNext, IMPORT_MEMORY_FD_INFO_KHR);
 
    if (fd_info && !fd_info->handleType)
       fd_info = NULL;
 
-   if (fd_info) {
+   if (wsi_info) {
+      result = device_alloc_for_wsi(device, pAllocator, mem,
+                                     pAllocateInfo->allocationSize);
+      if (result != VK_SUCCESS)
+         goto err_destroy_mem;
+   } else if (fd_info) {
       assert(
          fd_info->handleType == VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT ||
          fd_info->handleType == VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT);
@@ -242,6 +322,13 @@ panvk_FreeMemory(VkDevice _device, VkDeviceMemory _mem,
 
    panvk_memory_munmap(mem);
 
+   /* Free WSI dumb buffer if this was a WSI allocation */
