+static inline bool should_copy_plane(struct rkmpp_context *ctx, struct rkmpp_buffer *rkmpp_buffer,
+                                     unsigned int plane_idx, bool copy_to)
+{
+    if (copy_to) {
+        return ctx->is_decoder ? (rkmpp_buffer->planes[plane_idx].bytesused > 0) : true;
+    } else {
+        return rkmpp_buffer->planes[plane_idx].plane_size > 0;
+    }
+}
+
+static inline uint32_t get_copy_size(struct rkmpp_context *ctx, struct rkmpp_buffer *rkmpp_buffer,
+                                    struct v4l2_buffer *buffer, unsigned int plane_idx, bool copy_to)
+{
+    uint32_t size;
+
+    if (copy_to) {
+        size = ctx->is_decoder ? rkmpp_buffer->planes[plane_idx].bytesused :
+                                rkmpp_buffer->planes[plane_idx].plane_size;
+        return size ? size : rkmpp_buffer->planes[plane_idx].plane_size;
+    } else {
+        size = ctx->is_decoder ? buffer->m.planes[plane_idx].bytesused : buffer->m.planes[plane_idx].length;
+        return (size && size <= rkmpp_buffer->planes[plane_idx].plane_size) ? size :
+               rkmpp_buffer->planes[plane_idx].plane_size;
+    }
+}
+
+static inline uint32_t get_mpp_offset(struct rkmpp_context *ctx, struct rkmpp_buffer *rkmpp_buffer,
+                                     const uint32_t *sizes, unsigned int plane_idx)
+{
+    if (ctx->is_decoder) {
+        return plane_idx == 0 ? 0 : get_mpp_offset(ctx, rkmpp_buffer, sizes, plane_idx - 1) + sizes[plane_idx - 1];
+    } else {
+        return rkmpp_buffer->planes[plane_idx].bytesused - rkmpp_buffer->planes[plane_idx].plane_size;
+    }
+}
