Add context-aware logging macros for decoder/encoder filtering

This patch introduces new logging macros LOGV_CTX and LOGE_CTX that:
1. Add [DEC] or [ENC] prefix to distinguish decoder from encoder logs
2. Allow selective logging via RKMPP_LOG_TARGET macro:
   - RKMPP_LOG_TARGET_ALL (0): Log both decoder and encoder (default)
   - RKMPP_LOG_TARGET_DEC (1): Log decoder only
   - RKMPP_LOG_TARGET_ENC (2): Log encoder only
3. Maintain full compatibility with existing rkmpp_log_level variable
4. Keep original LOGV/LOGE macros for backward compatibility

Usage: Set RKMPP_LOG_TARGET=1 during compilation to see only decoder logs,
or RKMPP_LOG_TARGET=2 for encoder-only logs.

Index: libv4l-rkmpp/include/libv4l-rkmpp.h
===================================================================
--- libv4l-rkmpp.orig/include/libv4l-rkmpp.h
+++ libv4l-rkmpp/include/libv4l-rkmpp.h
@@ -79,6 +79,29 @@ __attribute__((format(printf, 5, 6))) vo
   log_prefix("RKMPP", __func__, __LINE__, errno, fmt, ##__VA_ARGS__); \
 	} while (0)
 
+/* Context-aware logging control macros */
+#define RKMPP_LOG_TARGET_ALL     0  /* Log both decoder and encoder */
+#define RKMPP_LOG_TARGET_DEC     1  /* Log decoder only */
+#define RKMPP_LOG_TARGET_ENC     2  /* Log encoder only */
+#ifndef RKMPP_LOG_TARGET
+#define RKMPP_LOG_TARGET RKMPP_LOG_TARGET_ALL  /* Default: log all */
+#endif
+
+/* Context-aware logging macros */
+#define LOGV_CTX(ctx, level, fmt, ...) \
+	do { \
+		bool should_log = (RKMPP_LOG_TARGET == RKMPP_LOG_TARGET_ALL) || \
+		                  (RKMPP_LOG_TARGET == RKMPP_LOG_TARGET_DEC && (ctx)->is_decoder) || \
+		                  (RKMPP_LOG_TARGET == RKMPP_LOG_TARGET_ENC && !(ctx)->is_decoder); \
+		if (rkmpp_log_level >= level && should_log) { \
+			log_prefix("RKMPP", __func__, __LINE__, errno, \
+			           "[%s] " fmt, (ctx)->is_decoder ? "DEC" : "ENC", ##__VA_ARGS__); \
+		} \
+	} while (0)
+
+#define LOGE_CTX(ctx, fmt, ...) LOGV_CTX(ctx, 0, "ERR: " fmt, ##__VA_ARGS__)
+
+/* Original logging macros (unchanged for compatibility) */
 #define LOGV(level, fmt, ...) \
 	do { if (rkmpp_log_level >= level) LOG(fmt, ##__VA_ARGS__); } while (0)
 
