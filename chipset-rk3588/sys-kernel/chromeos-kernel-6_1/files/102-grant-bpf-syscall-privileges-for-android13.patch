 /**
+ * bpf_ns_capable - Check a BPF capability against the current user namespace
+ * @cap: The capability in question (CAP_BPF, CAP_NET_ADMIN, CAP_PERFMON)
+ *
+ * Mirrors bpf_ns_capable()/bpf_token_capable() from v6.9+, which evaluate BPF
+ * privileges against the user namespace of the calling task (upstream: of the
+ * BPF token, falling back to init_user_ns). fydroid uses current_user_ns() so
+ * the ARC++ (Android 13) container -- which holds CAP_SYS_ADMIN/CAP_NET_ADMIN
+ * only in its own userns and does not use BPF tokens -- can create maps and
+ * load its networking programs. In init_user_ns this is identical to upstream
+ * behaviour. RE-CHECK ON KERNEL UPREV.
+ */
+bool bpf_ns_capable(int cap)
+{
+	struct user_namespace *ns = current_user_ns();
+
+	return ns_capable(ns, cap) ||
+	       (cap != CAP_SYS_ADMIN && ns_capable(ns, CAP_SYS_ADMIN));
+}
+EXPORT_SYMBOL(bpf_ns_capable);
+
+/**
  * ptracer_capable - Determine if the ptracer holds CAP_SYS_PTRACE in the namespace
  * @tsk: The task that may be ptraced
  * @ns: The user namespace to search for CAP_SYS_PTRACE in
