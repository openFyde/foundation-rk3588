+static s32
+wl_bss_handle_sae_auth_v3(struct bcm_cfg80211 *cfg, struct net_device *ndev,
+	const wl_event_msg_t *event, void *data)
+{
+	int err = BCME_OK;
+	wl_auth_event_t *auth_data;
+	wl_sae_key_info_t sae_key;
+	uint8 *pmk_data;
+	uint16 pmk_len;
+	size_t act_size = ksize(data);
+#ifdef WPA3_DEBUG
+	WL_ERR(("%s data:%p, size:%lu\n", __func__, data, act_size));
+	print_hex_dump(KERN_DEBUG, "sae_auth_v3: ", DUMP_PREFIX_ADDRESS, 16, 1,
+		data, act_size, false);
+#endif
+	auth_data = (wl_auth_event_t *)data;
+	if (!auth_data) {
+		WL_ERR(("Invalid param"));
+		return BCME_ERROR;
+	}
+
+	WL_ERR(("SAE v3: version=0x%04x, length=0x%04x, act_size=%lu\n",
+		auth_data->version, auth_data->length, act_size));
+
+	/* Initialize SAE key structure */
+	memset(&sae_key, 0, sizeof(sae_key));
+
+	/* Copy peer MAC address from event */
+	(void)memcpy_s(sae_key.peer_mac, ETHER_ADDR_LEN, event->addr.octet, ETHER_ADDR_LEN);
+
+	/* For v3, the length field appears to be unreliable, so use actual data size
+	 * Skip the 4-byte header (version + length) and extract PMK from xtlvs area
+	 */
+	if (act_size > WL_AUTH_EVENT_FIXED_LEN_V2) {
+		pmk_data = auth_data->xtlvs;
+		pmk_len = act_size - WL_AUTH_EVENT_FIXED_LEN_V2;
+
+		/* Skip any padding/reserved bytes and look for actual PMK data
+		 * Based on hex dump, PMK starts after initial bytes
+		 */
+		if (pmk_len > 8) {
+			/* Skip first 4 bytes (00 00 13 00) which appear to be TLV header/length */
+			pmk_data += 4;
+			pmk_len -= 4;
+
+			/* Limit PMK to reasonable size (32 bytes for WPA2, 48 for WPA3) */
+			if (pmk_len > 64) {
+				pmk_len = 48; /* Use standard PMK length */
+			}
+
+			sae_key.pmk = pmk_data;
+			sae_key.pmk_len = pmk_len;
+#ifdef WPA3_DEBUG
+			WL_ERR(("SAE v3: extracted PMK len=%u\n", sae_key.pmk_len));
+			print_hex_dump(KERN_INFO, "sae_v3_pmk: ", DUMP_PREFIX_OFFSET, 16, 1,
+				sae_key.pmk, sae_key.pmk_len, false);
+#endif
+			/* Process the SAE key */
+			err = wl_cfg80211_event_sae_key(cfg, ndev, &sae_key);
+			if (err) {
+				WL_ERR(("Failed to process SAE v3 key: %d\n", err));
+			} else {
+				WL_ERR(("Successfully processed SAE v3 key\n"));
+			}
+		} else {
+			WL_ERR(("SAE v3: insufficient data for PMK (len=%u)\n", pmk_len));
+			err = BCME_BUFTOOSHORT;
+		}
+	} else {
+		WL_ERR(("SAE v3: invalid data size %lu\n", act_size));
+		err = BCME_BUFTOOSHORT;
+	}
+
+	return err;
+}
