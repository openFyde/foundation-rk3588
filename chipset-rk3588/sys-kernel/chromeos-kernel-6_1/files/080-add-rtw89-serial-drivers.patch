+		rtw89_assign_entity_chan(rtwdev, idx, &chan);
+	}
+
+	if (hal->entity_pause)
+		return rtw89_get_entity_mode(rtwdev);
+
 	rtw89_set_entity_mode(rtwdev, mode);
