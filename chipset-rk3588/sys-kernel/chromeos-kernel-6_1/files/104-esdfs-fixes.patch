 #define ESDFS_ROOT_INO     1
@@ -497,7 +503,18 @@
 static inline void esdfs_copy_lower_attr(struct inode *dest,
 					 const struct inode *src)
 {
-	dest->i_mode = src->i_mode & S_IFMT;
+	/*
+	 * Never publish a permission-less mode on a live inode.  Every caller
+	 * but esdfs_iget() runs esdfs_set_perms() immediately after us, and that
+	 * stores the final mode in a single store; esdfs_iget() runs under I_NEW
+	 * with dest perms already 0, so preserving them is a no-op there.
+	 *
+	 * Storing (src type | dest perms) instead of bare "src->i_mode & S_IFMT"
+	 * keeps a racing esdfs_permission() -> generic_permission() from ever
+	 * observing mode 0000 and denying access to a file the caller owns.
+	 */
+	WRITE_ONCE(dest->i_mode,
+		   (src->i_mode & S_IFMT) | (dest->i_mode & ~S_IFMT));
 	dest->i_rdev = src->i_rdev;
 	dest->i_atime = src->i_atime;
 	dest->i_mtime = src->i_mtime;
