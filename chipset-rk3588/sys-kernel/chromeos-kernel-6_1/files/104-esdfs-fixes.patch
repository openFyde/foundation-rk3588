 #define ESDFS_IOC_DIS_ACCESS	_IO(ESDFS_IOCTL_MAGIC, 1)
+/*
+ * Counterpart to DIS_ACCESS.  Without this, ACCESS_DISABLE is a one-way latch:
+ * every path that tests it returns -ENOENT, so once set the whole mount looks
+ * permanently empty and only umount can recover it.
+ */
+#define ESDFS_IOC_EN_ACCESS	_IO(ESDFS_IOCTL_MAGIC, 2)
 
