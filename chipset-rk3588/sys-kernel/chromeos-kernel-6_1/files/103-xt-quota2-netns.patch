+static int __net_init quota2_net_init(struct net *net)
+{
+	struct xt_quota2_net *quota2_net = xt_quota2_pernet(net);
+
+	INIT_LIST_HEAD(&quota2_net->counter_list);
+	spin_lock_init(&quota2_net->counter_list_lock);
+
+	quota2_net->proc_xt_quota = proc_mkdir("xt_quota", net->proc_net);
+	if (quota2_net->proc_xt_quota == NULL)
+		return -ENOMEM;
+	/* Own the dir by the netns user-namespace root so it resolves to the
+	 * container's root rather than overflowuid:overflowuid inside the
+	 * container (global root for init_net). */
+	proc_set_user(quota2_net->proc_xt_quota,
+		      make_kuid(net->user_ns, 0), make_kgid(net->user_ns, 0));
+	return 0;
+}
+
+static void __net_exit quota2_net_exit(struct net *net)
+{
+	struct xt_quota2_net *quota2_net = xt_quota2_pernet(net);
+
+	/* This runs before quota_mt2_destroy() during netns teardown. Clear
+	 * proc_xt_quota first (under the lock) so any later destroy() skips
+	 * its per-counter remove_proc_entry(), then drop the whole subtree --
+	 * every counter entry under it -- in one shot. The counter structs
+	 * themselves are freed by quota_mt2_destroy() as the rules go away. */
+	spin_lock_bh(&quota2_net->counter_list_lock);
+	quota2_net->proc_xt_quota = NULL;
+	spin_unlock_bh(&quota2_net->counter_list_lock);
+
+	remove_proc_subtree("xt_quota", net->proc_net);
+}
+
+static struct pernet_operations quota2_net_ops = {
+	.init	= quota2_net_init,
+	.exit	= quota2_net_exit,
+	.id	= &quota2_net_id,
+	.size	= sizeof(struct xt_quota2_net),
+};
