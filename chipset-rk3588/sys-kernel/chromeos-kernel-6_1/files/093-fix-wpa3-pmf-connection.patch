Index: kernel-rockchip/drivers/net/wireless/rockchip_wlan/rkwifi/bcmdhd/Makefile
===================================================================
--- kernel-rockchip.orig/drivers/net/wireless/rockchip_wlan/rkwifi/bcmdhd/Makefile
+++ kernel-rockchip/drivers/net/wireless/rockchip_wlan/rkwifi/bcmdhd/Makefile
@@ -65,7 +65,7 @@ DHDCFLAGS = -Wall -Wstrict-prototypes -W
 	-DUSE_NEW_RSPEC_DEFS                                                  \
 	-DWL_EXT_IAPSTA -DWL_ESCAN -DCCODE_LIST -DSUSPEND_EVENT               \
 	-DKEY_INSTALL_CHECK                                                   \
-	-DENABLE_INSMOD_NO_FW_LOAD -DBCMDBG_ERR
+	-DENABLE_INSMOD_NO_FW_LOAD
 # add -DDHD_DEBUG for more infomation
 DHDOFILES = aiutils.o siutils.o sbutils.o                                 \
 	bcmutils.o bcmwifi_channels.o bcmxtlv.o bcm_app_utils.o bcmstdlib_s.o \
@@ -117,7 +117,6 @@ ifneq ($(CONFIG_CFG80211),)
 	DHDCFLAGS += -DGTK_OFFLOAD_SUPPORT
 #	DHDCFLAGS += -DWL_STATIC_IF #-DDHD_MAX_STATIC_IFS=2
 	DHDCFLAGS += -DWL_CLIENT_SAE -DWL_WPA3_TRANSITION_DISABLE -DWL_ENHANCED_PMF
-#-DWPA3_DEBUG
 	DHDCFLAGS += -DCONNECT_INFO_WAR -DWL_ROAM_WAR
 	DHDCFLAGS += -DVNDR_IE_WAR
 	DHDCFLAGS += -DRESTART_AP_WAR -DRXF0OVFL_REINIT_WAR
Index: kernel-rockchip/drivers/net/wireless/rockchip_wlan/rkwifi/bcmdhd/wl_cfg80211.c
===================================================================
--- kernel-rockchip.orig/drivers/net/wireless/rockchip_wlan/rkwifi/bcmdhd/wl_cfg80211.c
+++ kernel-rockchip/drivers/net/wireless/rockchip_wlan/rkwifi/bcmdhd/wl_cfg80211.c
@@ -5030,24 +5030,19 @@ wl_set_auth_type(struct net_device *dev,
 #endif /* WL_FILS */
 #if defined(WL_SAE) || defined(WL_CLIENT_SAE)
 	case NL80211_AUTHTYPE_SAE:
-#ifdef WL_CLIENT_SAE
-		if (!wl_is_pmkid_available(dev, sme->bssid))
-			val = DOT11_SAE;
-		else
-#endif /* WL_CLIENT_SAE */
-		{
-			/* Fw will choose right auth type
-			 * dynamically based on PMKID availability
-			 */
-			val = WL_AUTH_OPEN_SHARED;
-		}
-
-		WL_DBG(("sae auth type\n"));
-#ifdef WPA3_DEBUG
-		WL_ERR(("WPA3-SAE: Authentication initiated for BSSID %pM\n", sme->bssid));
-		WL_ERR(("WPA3-SAE: PMKID available: %s, Auth value: 0x%x\n",
-			wl_is_pmkid_available(dev, sme->bssid) ? "Yes" : "No", val));
-#endif /* WPA3_DEBUG */
+#ifdef WL_SAE
+		/* WL_SAE: Firmware handles SAE, always use DOT11_SAE */
+		val = DOT11_SAE;
+#else /* WL_CLIENT_SAE */
+		/* WL_CLIENT_SAE: wpa_supplicant handles SAE.
+		 * Use OPEN_SYSTEM auth type to allow external SAE authentication.
+		 * The driver will receive SAE frames via management frame
+		 * registration and forward them to wpa_supplicant.
+		 */
+		val = WL_AUTH_OPEN_SYSTEM;
+#endif /* WL_SAE */
+		WL_DBG(("WPA3-SAE: Authentication initiated for BSSID %pM, type:0x%x, PMKID available: %s\n",
+      sme->bssid, val, wl_is_pmkid_available(dev, sme->bssid) ? "Yes" : "No"));
 		break;
 #endif /* WL_SAE || WL_CLIENT_SAE */
 #ifdef BCMCCX
@@ -5463,6 +5458,19 @@ wl_cfg80211_set_mfp(struct bcm_cfg80211
 		}
 	}
 
+	/* Check if userspace explicitly requested MFP */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 9, 0))
+	if (sme->mfp == NL80211_MFP_REQUIRED) {
+		WL_INFORM_MEM(("Userspace requires MFP, setting MFP=REQUIRED\n"));
+		mfp = WL_MFP_REQUIRED;
+	} else if (sme->mfp == NL80211_MFP_OPTIONAL && mfp == WL_MFP_NONE) {
+		/* If userspace says optional and we haven't detected it yet,
+		 * set to CAPABLE to allow connection to both MFP and non-MFP networks
+		 */
+		mfp = WL_MFP_CAPABLE;
+	}
+#endif /* LINUX_VERSION_CODE >= KERNEL_VERSION(3, 9, 0) */
+
 	/* WPA3-SAE REQUIRES MFP - Override if SAE authentication is being used */
 	if (sec && (sec->wpa_auth & WPA3_AUTH_SAE_PSK) && (mfp == WL_MFP_NONE)) {
 		WL_INFORM_MEM(("WPA3-SAE detected but MFP=NONE! Forcing MFP=REQUIRED for WPA3\n"));
@@ -7380,6 +7388,17 @@ wl_cfg80211_connect(struct wiphy *wiphy,
 	chanspec_t scan_chspec = 1;
 
 	WL_DBG(("Enter len=%zu\n", sme->ie_len));
+#ifdef WPA3_DEBUG
+	WL_ERR(("WPA3-DEBUG: wl_cfg80211_connect called - SSID=%s auth_type=%d\n",
+		sme->ssid ? (char *)sme->ssid : "NULL", sme->auth_type));
+	if (sme->crypto.n_akm_suites > 0) {
+		WL_ERR(("WPA3-DEBUG: AKM suite[0]=0x%08x n_akm=%d\n",
+			sme->crypto.akm_suites[0], sme->crypto.n_akm_suites));
+	}
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 9, 0))
+	WL_ERR(("WPA3-DEBUG: sme->mfp=%d\n", sme->mfp));
+#endif
+#endif /* WPA3_DEBUG */
 	RETURN_EIO_IF_NOT_UP(cfg);
 
 	/* syncronize the connect states */
Index: kernel-rockchip/drivers/net/wireless/rockchip_wlan/rkwifi/bcmdhd/dhd_linux.c
===================================================================
--- kernel-rockchip.orig/drivers/net/wireless/rockchip_wlan/rkwifi/bcmdhd/dhd_linux.c
+++ kernel-rockchip/drivers/net/wireless/rockchip_wlan/rkwifi/bcmdhd/dhd_linux.c
@@ -10733,6 +10733,15 @@ dhd_get_fw_capabilities(dhd_pub_t * dhd)
 	dhd->fw_capabilities[cap_buf_size - 2] = ' ';
 	dhd->fw_capabilities[cap_buf_size - 1] = '\0';
 
+	/* Print all firmware capabilities for WPA3 debugging */
+	{
+		DHD_ERROR(("%s: ========== FW CAPABILITIES START ==========\n", __FUNCTION__));
+		DHD_ERROR(("%s: Full capability string (size=%d):\n", __FUNCTION__, cap_buf_size));
+		/* Print the full string first */
+		DHD_ERROR(("%s: [%s]\n", __FUNCTION__, dhd->fw_capabilities));
+		DHD_ERROR(("%s: ========== FW CAPABILITIES END ==========\n", __FUNCTION__));
+	}
+
 	return 0;
 }
 
@@ -10742,6 +10751,7 @@ dhd_optimised_preinit_ioctls(dhd_pub_t *
 	int ret = 0;
 	/*  Room for "event_msgs_ext" + '\0' + bitvec  */
 	char iovbuf[WL_EVENTING_MASK_EXT_LEN + EVENTMSGS_EXT_STRUCT_SIZE + 16];
+
 	uint32 event_log_max_sets = 0;
 	char* iov_buf = NULL;
 	/* XXX: Use ret2 for return check of IOVARS that might return BCME_UNSUPPORTED,
@@ -11798,6 +11808,16 @@ dhd_legacy_preinit_ioctls(dhd_pub_t *dhd
 		op_mode = DHD_FLAG_MFG_MODE;
 	}
 
+	/* Get firmware capabilities for WPA3 debugging */
+	ret = dhd_get_fw_capabilities(dhd);
+	if (ret < 0) {
+		DHD_ERROR(("%s: dhd_get_fw_capabilities failed (error=%d)\n", __FUNCTION__, ret));
+		/* Continue anyway, don't fail initialization */
+	} else {
+		DHD_ERROR(("%s: dhd_get_fw_capabilities succeeded\n", __FUNCTION__));
+	}
+	ret = 0; /* Reset ret to continue with other ioctls */
+
 	if ((!op_mode && dhd_get_fw_mode(dhd->info) == DHD_FLAG_MFG_MODE) ||
 		(op_mode == DHD_FLAG_MFG_MODE)) {
 		dhd->op_mode = DHD_FLAG_MFG_MODE;
@@ -14063,7 +14083,7 @@ dhd_register_if(dhd_pub_t *dhdp, int ifi
 #if defined(BCMPCIE) && defined(DHDTCPACK_SUPPRESS)
 			dhd_tcpack_suppress_set(dhdp, TCPACK_SUP_OFF);
 #endif /* BCMPCIE && DHDTCPACK_SUPPRESS */
-
+#if 0 /* linux doesn't need turning off Wifi */
 #if defined(WLAN_ACCEL_BOOT)
 			/*
 			 * Make Wifi suspended after boot up with forge_reg_on true
@@ -14082,7 +14102,7 @@ dhd_register_if(dhd_pub_t *dhdp, int ifi
 			wl_android_wifi_off(net, TRUE);
 #endif /* BT_OVER_SDIO */
 #endif /* WLAN_ACCEL_BOOT */
-
+#endif
 		}
 	}
 #endif /* OEM_ANDROID && (BCMPCIE || (BCMLXSDMMC) */
