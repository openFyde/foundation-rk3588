+	[IPI_SHUTDN]		= GRF_REG_FIELD(0x0000,  9,  9),
+	[IPI_COLORM]		= GRF_REG_FIELD(0x0000,  8,  8),
+	[IPI_COLOR_DEPTH]	= GRF_REG_FIELD(0x0000,  4,  7),
+	[IPI_FORMAT]		= GRF_REG_FIELD(0x0000,  0,  3),
