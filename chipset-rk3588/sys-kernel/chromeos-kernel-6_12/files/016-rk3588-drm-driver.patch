+static void dw_dp_unregister_audio_driver(void *data)
+{
+	struct dw_dp_audio *audio = data;
+
+	if (audio->pdev) {
+		platform_device_unregister(audio->pdev);
+		audio->pdev = NULL;
+	}
+}
