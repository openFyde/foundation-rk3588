+{
+	u32 val = 0;
+
+	if (IS_ERR_OR_NULL(regmap))
+		return;
+
+	if (reg.mask) {
+		val = (v << reg.shift) | (reg.mask << (reg.shift + 16));
+		regmap_write(regmap, reg.offset, val);
+	}
+}
