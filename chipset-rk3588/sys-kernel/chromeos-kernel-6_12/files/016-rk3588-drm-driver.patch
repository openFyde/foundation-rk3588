+static const struct regmap_config dw_mipi_dsi2_regmap_config = {
+	.name = "host",
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.fast_io = true,
+	.max_register = DSI2_MAX_REGISGER,
+};
