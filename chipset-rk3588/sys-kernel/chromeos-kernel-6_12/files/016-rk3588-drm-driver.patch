+	vp_data = &vop2_data->vp[vp_id];
+	intr = vp_data->intr;
+	val = VOP_INTR_GET_TYPE(vop2, intr, status, INTR_MASK);
+	if (val)
+		VOP_INTR_SET_TYPE(vop2, intr, clear, val, 1);
+	return val;
