+static void vop2_wb_disable(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+	struct vop2_wb *wb = &vop2->wb;
+
+	VOP_MODULE_SET(vop2, wb, enable, 0);
+	VOP_CTRL_SET(vop2, wb_dma_finish_and_en, 0);
+	vop2_wb_cfg_done(vp);
+}
