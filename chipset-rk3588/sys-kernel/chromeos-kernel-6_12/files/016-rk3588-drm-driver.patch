+static void dw_dp_mst_encoder_cleanup(struct drm_encoder *encoder)
+{
+	struct dw_dp_mst_enc *mst_enc = container_of(encoder, struct dw_dp_mst_enc, encoder);
+	struct dw_dp *dp = mst_enc->dp;
+
+	if (!dp->support_mst)
+		return;
+
