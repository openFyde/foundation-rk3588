+	if (pstate->fb->modifier == DRM_FORMAT_MOD_LINEAR)
+		xoffset = 0;
+	else
+		xoffset = pstate->src.x1 >> 16;
+
+	if ((actual_w + xoffset % 16) > 2048) {
+		DRM_ERROR("%s act_w(%d) + xoffset(%d) / 16  << 2048 in two win mode\n",
