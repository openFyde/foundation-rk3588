+	struct drm_property_blob *new_blob = new_vcstate->acm_lut_data;
+	bool ret;
+
+	ret = vop2_blob_changed(new_blob, old_blob);
+
+	if (!ret)
+		return ret;
+
+	if (new_blob)
+		memcpy(&vp->acm_info, new_blob->data, sizeof(struct post_acm));
+	else
+		memset(&vp->acm_info, 0, sizeof(struct post_acm));
+
+	return ret;
