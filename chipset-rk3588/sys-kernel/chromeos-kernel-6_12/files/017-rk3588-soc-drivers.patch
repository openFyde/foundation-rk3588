+	hdptx_update_bits(hdptx, SB_REG0103, OVRD_SB_RX_RESCAL_DONE_MASK,
+		       OVRD_SB_RX_RESCAL_DONE(1));
+	hdptx_update_bits(hdptx, SB_REG0104, OVRD_SB_EN_MASK,
