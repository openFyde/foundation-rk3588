+static int proc_powersave_init(void)
+{
+	/* create dmcinfo file */
+	proc_create(PROC_DMCDBG_POWERSAVE, 0644, proc_dmcdbg_dir,
+		    &powersave_proc_fops);
+
+	return 0;
+}
