+		   "\n"
+		   "Support for setting multiple parameters at the same time.\n"
+		   "echo number=value,number=value,... > /proc/dmcdbg/powersave\n"
+		   "eg:\n"
+		   "  echo 0=1,1=32 > /proc/dmcdbg/powersave\n"
+		   );
