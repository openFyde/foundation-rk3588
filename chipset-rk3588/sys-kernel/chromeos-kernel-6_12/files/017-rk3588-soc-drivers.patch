--- /dev/null
+++ kernel-6_12/drivers/devfreq/rockchip_dmc_common.c
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Rockchip dmc common functions.
