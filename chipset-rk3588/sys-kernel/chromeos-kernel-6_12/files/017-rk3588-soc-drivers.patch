+static void rockchip_dmcfreq_update_target(struct rockchip_dmcfreq *dmcfreq)
+{
+	struct devfreq *devfreq = dmcfreq->info.devfreq;
+
+	mutex_lock(&devfreq->lock);
+	update_devfreq(devfreq);
+	mutex_unlock(&devfreq->lock);
+}
