Index: kernel-6_12/drivers/media/platform/rockchip/Kconfig
===================================================================
--- kernel-6_12.orig/drivers/media/platform/rockchip/Kconfig
+++ kernel-6_12/drivers/media/platform/rockchip/Kconfig
@@ -2,5 +2,19 @@
 
 comment "Rockchip media platform drivers"
 
+config VIDEO_RK3588_AV1_DEC
+	tristate "Rockchip RK3588 AV1 Video Decoder"
+	depends on VIDEO_DEV && VIDEO_V4L2_SUBDEV_API
+	depends on ARCH_ROCKCHIP || COMPILE_TEST
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_MEM2MEM_DEV
+	help
+	  Support for the Rockchip RK3588 AV1 hardware video decoder.
+	  This is a V4L2 stateless decoder driver that uses the VDPU383
+	  hardware accelerator. Based on Rockchip MPP architecture.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called rk3588-av1-dec.
+
 source "drivers/media/platform/rockchip/rga/Kconfig"
 source "drivers/media/platform/rockchip/rkisp1/Kconfig"
