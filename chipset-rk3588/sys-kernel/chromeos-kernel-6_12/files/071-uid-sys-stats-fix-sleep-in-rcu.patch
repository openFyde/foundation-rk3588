+/*
+ * get_full_task_comm() sleeps: it takes mm->mmap_lock and calls get_cmdline(),
+ * which may fault in userspace memory. The task list walks below hold
+ * rcu_read_lock(), so the full comm cannot be fetched inline. Instead pin the
+ * task and queue it on a deferred list, then resolve the comms after
+ * rcu_read_unlock() (still under the sleeping uid_lock).
+ */
+struct task_comm_defer {
+	struct list_head node;
+	struct task_struct *task;
+	struct task_entry *task_entry;
+};
+
 static void get_full_task_comm(struct task_entry *task_entry,
 		struct task_struct *task)
 {
@@ -202,8 +215,44 @@ static void get_full_task_comm(struct ta
 	task_entry->comm[i] = '\0';
 }
 
+/*
+ * Queue a task whose full comm must be (re)fetched. Called from under
+ * rcu_read_lock(); the referenced task is released in
+ * resolve_deferred_task_comm() once the actual (sleeping) fetch is done.
+ */
+static void defer_full_task_comm(struct list_head *defer,
+		struct task_entry *task_entry, struct task_struct *task)
+{
+	struct task_comm_defer *d;
+
+	if (!defer)
+		return;
+
+	d = kmalloc(sizeof(*d), GFP_ATOMIC);
+	if (!d)
+		return;
+
+	get_task_struct(task);
+	d->task = task;
+	d->task_entry = task_entry;
+	list_add(&d->node, defer);
+}
+
+/* Fetch the deferred comms outside of the RCU read-side critical section. */
+static void resolve_deferred_task_comm(struct list_head *defer)
+{
+	struct task_comm_defer *d, *tmp;
+
+	list_for_each_entry_safe(d, tmp, defer, node) {
+		get_full_task_comm(d->task_entry, d->task);
+		put_task_struct(d->task);
+		list_del(&d->node);
+		kfree(d);
+	}
+}
