+
+	/* mclk from machine driver (mclk-fs); CLK_DIV field is divider - 1 */
+	div = DIV_ROUND_CLOSEST(clk_get_rate(spdif->mclk), 128 * srate) - 1;
+	val |= SPDIF_CFGR_CLK_DIV(div);
 
