+	  To compile this driver as a module, choose M here: the
+	  module will be called himax_chipset.
+
+if TOUCHSCREEN_HIMAX_CHIPSET
+  source "drivers/input/touchscreen/hxchipset/Kconfig"
+endif
+
 endif
