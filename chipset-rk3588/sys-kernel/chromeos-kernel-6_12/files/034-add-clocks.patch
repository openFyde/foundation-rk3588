-		clock-output-names = "xin32k";
-		#clock-cells = <0>;
-	};
+		spll: clock-0 {
+			compatible = "fixed-clock";
+			clock-frequency = <702000000>;
+			clock-output-names = "spll";
+			#clock-cells = <0>;
+		};
+
+		xin24m: clock-1 {
+			compatible = "fixed-clock";
+			clock-frequency = <24000000>;
+			clock-output-names = "xin24m";
+			#clock-cells = <0>;
+		};
+
+		xin32k: clock-2 {
+			compatible = "fixed-clock";
+			clock-frequency = <32768>;
+			clock-output-names = "xin32k";
+			#clock-cells = <0>;
+		};
+  };
 
 	reserved-memory {
 		#address-cells = <2>;
