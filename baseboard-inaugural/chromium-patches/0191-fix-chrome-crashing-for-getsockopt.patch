Index: src/sandbox/linux/seccomp-bpf-helpers/baseline_policy.cc
===================================================================
--- src.orig/sandbox/linux/seccomp-bpf-helpers/baseline_policy.cc
+++ src/sandbox/linux/seccomp-bpf-helpers/baseline_policy.cc
@@ -5,6 +5,7 @@
 #include "sandbox/linux/seccomp-bpf-helpers/baseline_policy.h"
 
 #include <errno.h>
+#include <linux/udp.h>
 #include <sys/mman.h>
 #include <sys/socket.h>
 #include <sys/syscall.h>
@@ -27,6 +28,10 @@
 #define SO_PEEK_OFF 42
 #endif
 
+#if !defined(SOL_UDP)
+#define SOL_UDP 17
+#endif
+
 // Changing this implementation will have an effect on *all* policies.
 // Currently this means: Renderer/Worker, GPU, Flash and NaCl.
 
@@ -347,12 +352,19 @@ ResultExpr EvaluateSyscallImpl(int fs_de
     return RestrictSocketcallCommand();
 #endif
 
-  if (sysno == __NR_getsockopt || sysno ==__NR_setsockopt) {
+  // getsockopt is read-only and generally safe, allow it broadly.
+  // setsockopt can modify socket behavior, so keep it restricted.
+  if (sysno == __NR_getsockopt) {
+    return Allow();
+  }
+
+  if (sysno == __NR_setsockopt) {
     // Used by Mojo EDK to catch a message pipe being sent over itself.
     // TODO(crbug.com/40528912): is this still needed?
     const Arg<int> level(1);
     const Arg<int> optname(2);
     return If(AllOf(level == SOL_SOCKET, optname == SO_PEEK_OFF), Allow())
+        .ElseIf(AllOf(level == SOL_UDP, optname == UDP_CORK), Allow())
         .Else(CrashSIGSYS());
   }
 
